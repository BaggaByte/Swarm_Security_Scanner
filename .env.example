# Swarm Security Scanner — Production Environment Configuration
# Copy this file to .env and configure secrets securely.

# ─── API Security ───
# Required for production: generate a strong 256-bit token (e.g. `openssl rand -hex 32`)
SWARM_API_KEY=

# For local development only: set to 'true' to allow unauthenticated API calls
SWARM_ALLOW_ANONYMOUS=false

# Allowed CORS origins (comma-separated)
SWARM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# ─── GitHub Webhook Security ───
# Shared secret for HMAC-SHA256 signature verification (X-Hub-Signature-256)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# ─── Scan Boundary & SSRF Controls ───
# Optional: restrict local repository scans to a specific base directory
# SWARM_ALLOWED_SCAN_ROOT=/workspace/repos

# ─── Exploit Validation Sandbox ───
SWARM_SANDBOX_IMAGE=antigravity-sandbox:latest
SWARM_SANDBOX_NETWORK=none
# Comma-separated list of allowed target URLs for verification
SWARM_ALLOWED_SANDBOX_TARGETS=http://localhost:5000,http://127.0.0.1:5000,http://sandbox-target:5000

# ─── Concurrency & Persistence ───
SWARM_MAX_CONCURRENT_SCANS=3
SWARM_DB_PATH=backend/swarm_runs.db

# ─── LLM Inference Providers ───
# GROQ_API_KEY=gsk_...
# OLLAMA_HOST=http://localhost:11434
