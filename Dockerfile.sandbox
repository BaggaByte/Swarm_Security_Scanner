FROM python:3.11-alpine

# Set secure execution flags
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Create unprivileged non-root user (UID 1000)
RUN adduser -u 1000 -D -s /sbin/nologin sandboxuser

# Install minimal testing dependencies
RUN pip install --no-cache-dir requests urllib3

# Switch to non-root user
USER 1000:1000
WORKDIR /home/sandboxuser

# Default command
CMD ["python3"]
