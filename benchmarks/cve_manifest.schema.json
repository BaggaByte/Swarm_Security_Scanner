{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Swarm CVE benchmark manifest",
  "type": "object",
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "description": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["cve_id", "repo_url", "vulnerable_ref", "patched_ref", "expected_file"],
        "properties": {
          "cve_id": { "type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$" },
          "project": { "type": "string" },
          "repo_url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "vulnerable_ref": { "type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" },
          "patched_ref": { "type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" },
          "expected_file": { "type": "string", "minLength": 1 },
          "discovery_lines": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
          "line": { "type": "integer", "minimum": 1 },
          "line_tolerance": { "type": "integer", "minimum": 0, "default": 20 },
          "cwe": { "type": "string", "pattern": "^CWE-[0-9]+$" },
          "match_keywords": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
          },
          "advisory_url": { "type": "string", "format": "uri" },
          "patch_url": { "type": "string", "format": "uri" }
        },
        "anyOf": [
          { "required": ["cwe"] },
          { "required": ["match_keywords"], "properties": { "match_keywords": { "minItems": 1 } } }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
